# Started once qseecomd has registered its listeners; libqtigatekeeper reaches
# its trustlet through QSEECom.
service vendor.gatekeeper_default /system/bin/hal-launch.sh /vendor/bin/hw/android.hardware.gatekeeper-service-qti
    disabled
    class early_hal
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0
