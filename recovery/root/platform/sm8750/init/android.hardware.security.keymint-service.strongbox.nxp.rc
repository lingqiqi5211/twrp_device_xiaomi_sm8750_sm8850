# StrongBox KeyMint lives in the same NXP element as its weaver, and the lock
# credential path reaches both. Stock runs it as vendor_nxp_strongbox.
service odm.keymint-strongbox-nxp /system/bin/hal-launch.sh /odm/bin/hw/android.hardware.security.keymint-service.strongbox-nxp
    disabled
    class early_hal
    user root
    group root drmrpc nfc
    capabilities WAKE_ALARM
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0
