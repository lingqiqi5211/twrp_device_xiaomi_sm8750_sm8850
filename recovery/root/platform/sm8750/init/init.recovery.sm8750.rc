on early-init
    exec u:r:recovery:s0 root root -- /system/bin/sh /platform/sm8750/early.sh

on init
    # exec, not start: ro.twrp.weaver has to exist before the triggers that test it.
    exec u:r:recovery:s0 root root -- /system/bin/weaver-vendor.sh
    start vendor.boot-qti
    setprop prepdecrypt.setpatch true
    start odm.wait-vendor

on property:ro.boot.hardware.sku=piano
    setprop persist.twrp.rotation 270

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    wait /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} 10
    mkdir /firmware 0755 root system
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro

    # Its SSD listener opens by-name/ssd, which ueventd may not have made yet.
    wait /dev/block/bootdevice/by-name/ssd 10
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    # TWRP keeps its settings in TW_PERSIST_DIR, which upstream moved to
    # /mnt/vendor/persist/TWRP. A tmpfs there takes those writes and drops
    # them at reboot, and the vibrator HAL reads its calibration off the
    # same partition. TWRP unmounts its own mount points at startup, so the
    # real partition goes to /persist and /mnt/vendor/persist is a bind of
    # it: a separate mount entry TWRP never touches.
    wait /dev/block/bootdevice/by-name/persist 10
    mount ext4 /dev/block/bootdevice/by-name/persist /persist noatime nosuid nodev barrier=1
    mount none /persist /mnt/vendor/persist bind
    install_keyring
    start vendor.qseecomd

on post-fs
    # Blocks until the props are set: recovery starts at boot and reads the model at once.
    exec_start odm.variant-script

on boot
    setprop sys.usb.config adb

# qseecomd is up, so the HALs that reach a trustlet through it can follow.
on property:vendor.sys.listeners.registered=true
    start vendor.gatekeeper_default

# The eSE HAL asks the element for its vendor id before it can open the TA, and
# the health HAL reads the gauge off the PMIC: both answers come back through
# the ADSP. nxp_nci is a vendor module as well, and wait-adsp only runs once the
# modules are in, so this one trigger carries both preconditions. Started any
# earlier the eSE HAL logs "eseGetVendorId: Unknown eSE HW" and exits.
#
# The eSE part only goes to the SKUs that have one. The HAL looks for
# /dev/nq-nci and /dev/st54spi_gpio and exits when it finds neither, which on
# piano is every time -- that tablet has no eSE node in its device tree at all,
# so the service respawned every five seconds and se_omapi waited on it forever.
on property:twrp.adsp.ready=true && property:vendor.sys.listeners.registered=true
    start vendor.health-default

on property:twrp.adsp.ready=true && property:vendor.sys.listeners.registered=true && property:ro.twrp.weaver=nxp
    start vendor.secure_element

on property:twrp.adsp.ready=true && property:vendor.sys.listeners.registered=true && property:ro.twrp.weaver=thales
    start vendor.secure_element

# The haptics driver is one of the vendor modules, so the HAL has nothing to
# talk to until they are in. lsmod on warsaw shows qcom_hv_haptics loaded from
# vendor_dlkm.
on property:twrp.variant.files_copied=1 && property:twrp.modules.loaded=true
    start odm.vibratorfeature-service

on property:twrp.variant.files_copied=1
    start odm.touch_report

# One weaver per device, and exactly one VINTF declaration for it.
#
# Both vendors' services provide IWeaver/default @2, so the single fragment in
# vendor/etc/vintf/manifest/android.hardware.weaver-service.xml covers whichever
# one runs. Shipping a second fragment for the other vendor makes VINTF reject
# the entire device manifest -- measured on warsaw: every HAL lookup then fails,
# ISecureElement/eSE1 among them, and the device resets.
#
# Only one service may run either, since the second to register IWeaver/default
# replaces the first. Starting the wrong vendor's is worse than starting none:
# the Thales chain on a device whose element is NXP hard-resets recovery a few
# seconds in. variant-script names the vendor in ro.twrp.weaver.
on property:twrp.variant.files_copied=1 && property:ro.twrp.weaver=thales
    start odm.weaver-service

on property:twrp.variant.files_copied=1 && property:ro.twrp.weaver=nxp
    start odm.weaver_nxp

# piano has no element, so neither eSE service can answer for it. Its slots are
# in the weaver GP TA and Xiaomi's own service is what reads them: the Thales
# one asked the TA too, as a "backup", but returned the applet's failure and
# TWRP got nothing but "Failed to get weaver key size".
on property:twrp.variant.files_copied=1 && property:ro.twrp.weaver=mi
    start odm.weaver_mi

on property:twrp.modules.loaded=true
    # KeyMint stays down until this has pointed the version properties at the
    # installed system, so start it as early as the mapper nodes allow.
    start odm.prepdecrypt
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    # This make USB-OTG work
    wait /sys/kernel/boot_adsp/ssr
    write /sys/kernel/boot_adsp/ssr 1
    start vendor.wait-adsp
    setprop twrp.firmware.mounted true

# The stock vendor partition is first-stage-mounted over the ramdisk's own
# /vendor, and TWRP mounts it again for the partition list and leaves it there,
# hiding our libraries, our HAL binaries and our trustlets all at once. Bind
# them somewhere the stock partition cannot reach while they are still
# visible; hal-launch.sh takes all three from here.
on property:twrp.vendor.visible=1
    mkdir /twrplib 0755 root root
    mkdir /twrplib/vendor 0755 root root
    mkdir /twrplib/vendorhw 0755 root root
    mkdir /twrplib/vendorbin 0755 root root
    mkdir /twrplib/odm 0755 root root
    mkdir /twrplib/odmbin 0755 root root
    mount none /vendor/lib64 /twrplib/vendor bind
    mount none /vendor/lib64/hw /twrplib/vendorhw bind
    mount none /vendor/bin/hw /twrplib/vendorbin bind
    mount none /odm/lib64 /twrplib/odm bind
    mount none /odm/bin/hw /twrplib/odmbin bind
    mount none /firmware /vendor/firmware_mnt bind
    write /twrplib/.staged 1
    setprop twrp.libs.staged 1

service vendor.wait-adsp /system/bin/sh /system/bin/wait-adsp-ready.sh
    class hal
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
